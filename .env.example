# AgentPay Gateway MCP — Environment Variables

# ── Required ──────────────────────────────────────────────
# Supabase credentials (get from https://supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=service_role_your_key_here

# Stripe API key (get from https://dashboard.stripe.com → Developers → API keys)
STRIPE_API_KEY=sk_live_your_key_here

# Stripe webhook endpoint secret (for verifying incoming webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Stripe Checkout Link ─────────────────────────────────
# Create a Stripe checkout session URL or leave as placeholder.
# Replace with your actual Stripe checkout link after setup:
STRIPE_CHECKOUT_LINK=https://buy.stripe.com/c/agentpay/checkout/pro

# ── Optional ──────────────────────────────────────────────
# Stripe Price ID (if you've created the product/price in Stripe)
STRIPE_PRO_PRICE_ID=price_agentpay_pro_monthly

# HTTP port for the gateway server
PORT=8000

# Set to "1" to connect to backend MCP servers via local stdio (for development)
# Leave as "0" for HTTP proxy mode (production)
LOCAL_BACKENDS=0

# ── Backend Server URLs (override defaults) ─────────────
# Uncomment and modify to point to your deployed backend servers
# SEARCH_PROXY_URL=http://localhost:8011
# AUDIT_SERVER_URL=http://localhost:8012
# CONTRACT_SERVER_URL=http://localhost:8013